---
const { title, subtitle, caption } = Astro.props;
---

<div class="flex">
  {/* timeline dot + line */}
  <div class="education__time flex flex-col items-center">
    <span class="w-4 h-4 bg-[#FADADD] block rounded-full mt-1"></span>
    <span class="education__line bg-[#FADADD] block h-full w-[2px] mt-1"></span>
  </div>

  {/* content */}
  <div class="experience__data bd-grid px-5 pb-6">
    <h3 class="font-semibold text-lg mb-1">{title}</h3>

    <span class="font-light text-sm text-pink-300">
      {subtitle}
    </span>

    {caption && (
      <div class="mt-2 text-sm italic text-pink-200">
        {caption}
      </div>
    )}

    <slot />
  </div>
</div>