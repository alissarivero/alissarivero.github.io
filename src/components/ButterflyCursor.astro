---
/* Follows the pointer at a constant slow speed (non-home pages). */
---

<div id="cursor-butterfly-root" class="butterfly-cursor-root" aria-hidden="true">
  <img src="/butterfly.svg" alt="" width="52" height="52" decoding="async" />
</div>

<style>
  .butterfly-cursor-root {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 65;
    width: var(--bf-cursor-size, 52px);
    height: var(--bf-cursor-size, 52px);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease-out;
    will-change: transform;
  }

  .butterfly-cursor-root.is-active {
    opacity: 1;
    visibility: visible;
  }

  .butterfly-cursor-root img {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    animation: bf-cursor-flap 0.85s ease-in-out infinite;
  }

  @keyframes bf-cursor-flap {
    0%,
    100% {
      transform: rotate(-3deg) scale(1);
    }
    50% {
      transform: rotate(3deg) scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .butterfly-cursor-root {
      display: none !important;
    }
    .butterfly-cursor-root img {
      animation: none !important;
    }
  }
</style>

<script>
  let cleanup = null;

  function setupCursorButterfly() {
    cleanup?.();
    cleanup = null;

    const root = document.getElementById("cursor-butterfly-root");
    if (!root) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let mx = window.innerWidth * 0.5;
    let my = window.innerHeight * 0.5;
    let bx = mx;
    let by = my;
    /** Constant chase speed (px/s) — no boost when far from the cursor */
    const speed = 42;

    let started = false;
    let raf = 0;
    let lastTs = 0;
    let lastAngle = 0;

    const applyTransform = () => {
      const dx = mx - bx;
      const dy = my - by;
      const dist = Math.hypot(dx, dy);
      if (dist > 0.75) {
        lastAngle = (Math.atan2(dy, dx) * 180) / Math.PI;
      }
      root.style.transform = `translate3d(${bx}px, ${by}px, 0) translate(-50%, -50%) rotate(${lastAngle + 90}deg)`;
    };

    /** Every frame: move toward cursor at fixed speed; snap when on the pointer. */
    const tick = (ts) => {
      if (!lastTs) lastTs = ts;
      const dt = Math.min((ts - lastTs) / 1000, 0.05);
      lastTs = ts;

      const dx = mx - bx;
      const dy = my - by;
      const dist = Math.hypot(dx, dy);
      if (dist > 0.03) {
        const step = Math.min(speed * dt, dist);
        bx += (dx / dist) * step;
        by += (dy / dist) * step;
      } else {
        bx = mx;
        by = my;
      }
      applyTransform();
      raf = requestAnimationFrame(tick);
    };

    const onMove = (e) => {
      mx = e.clientX;
      my = e.clientY;

      if (!started) {
        started = true;
        bx = mx;
        by = my;
        root.classList.add("is-active");
        applyTransform();
        raf = requestAnimationFrame(tick);
      }
    };

    window.addEventListener("mousemove", onMove, { passive: true });

    cleanup = () => {
      window.removeEventListener("mousemove", onMove);
      cancelAnimationFrame(raf);
      root.classList.remove("is-active");
      started = false;
      lastTs = 0;
    };
  }

  document.addEventListener("astro:page-load", setupCursorButterfly);
  queueMicrotask(() => setupCursorButterfly());
</script>
