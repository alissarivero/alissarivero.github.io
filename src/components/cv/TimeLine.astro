---
const { title, subtitle, caption, answer } = Astro.props;
const isQA = typeof answer === "string" && answer.length > 0;

/** Escape then wrap Research-Questions keywords in timeline-line pink (#D4A6B2). */
function questionHtml(raw: string): string {
  const safe = raw
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
  // Longer phrases first: "peer instruction" before "peer"; "peers" before "peer"
  return safe.replace(
    /\b(coordinate|exploit|peer instruction|peers|effort|peer|reset)\b/gi,
    '<span style="color:#D4A6B2">$1</span>'
  );
}
---

<div class="flex">
  <div class="education__time">
    <span class="w-4 h-4 bg-[#E7D6DC] block rounded-full mt-1"></span>
    <span class="education__line bg-[#D4A6B2] block h-full w-[2px] translate-x-[7px]"></span>
  </div>

  <div class="experience__data bd-grid px-5 pb-6">
    {isQA ? (
      <>
        <h3 class="font-semibold text-lg leading-snug mb-1 md:text-xl text-white/90">
          <span>Q.</span>
          <span class="pl-1.5 tracking-[0.04em]" set:html={questionHtml(title)} />
        </h3>
        <div class="text-base leading-relaxed text-white/70 mt-2.5">
          <span class="text-white/70 font-medium">A.</span>
          <span class="pl-1.5">{answer}</span>
        </div>
      </>
    ) : (
      <>
        <h3 class="text-white font-semibold text-lg leading-snug mb-1">
          {title}
        </h3>

        <div class="text-white text-sm">
          {subtitle}
        </div>

        {caption && (
          <div class="mt-2 text-sm italic text-white">
            {caption}
          </div>
        )}
      </>
    )}

    <slot />
  </div>
</div>