---
const { title, subtitle, caption } = Astro.props;
---

<div class="flex">
  {/* timeline */}
  <div class="flex flex-col items-center">
    <span class="w-4 h-4 bg-[#E7D6DC] rounded-full mt-1"></span>
    <span class="bg-[#E7D6DC] w-[2px] flex-1 mt-1"></span>
  </div>

  {/* content */}
  <div class="px-5 pb-7">
    {/* title */}
    <h3 class="text-white font-semibold text-lg leading-snug">
      {title}
    </h3>

    {/* authors */}
    <div class="text-white/80 text-sm mt-1">
      {subtitle}
    </div>

    {/* journal */}
    {caption && (
      <div class="text-[#C7A9B4] text-sm italic mt-2">
        {caption}
      </div>
    )}

    <slot />
  </div>
</div>