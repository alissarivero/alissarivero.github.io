---
import Figures from "./Figures.astro";

interface Props {
  overview: string[];
  detailed: string[];
  points?: string[];
  credit?: string;
  figures?: { after: number; id: string }[];
}

const { overview, detailed, points = [], credit = "", figures = [] } = Astro.props;
const boldPhrases = ["No prior statistics or programming experience required.", "Completely free"];
const pieces = (text: string) => {
  const out: { text: string; bold: boolean }[] = [];
  let rest = text;
  while (rest.length > 0) {
    const hit = boldPhrases
      .map((phrase) => ({ phrase, index: rest.indexOf(phrase) }))
      .filter((item) => item.index >= 0)
      .sort((a, b) => a.index - b.index)[0];
    if (!hit) {
      out.push({ text: rest, bold: false });
      break;
    }
    if (hit.index > 0) out.push({ text: rest.slice(0, hit.index), bold: false });
    out.push({ text: hit.phrase, bold: true });
    rest = rest.slice(hit.index + hit.phrase.length);
  }
  return out;
};
const hasDetail = detailed.length > 0;
---

<div class="levels">
  {
    hasDetail && (
      <div class="level-tabs" role="tablist" aria-label="Depth of explanation">
        <button type="button" role="tab" aria-selected="true" data-tab="overview">
          Overview
        </button>
        <button type="button" role="tab" aria-selected="false" data-tab="detailed">
          More detail
        </button>
      </div>
    )
  }
  <div class="level-panel" data-panel="overview">
    {
      overview.map((paragraph, index) => (
        <>
          <p>
            {pieces(paragraph).map((part) => (part.bold ? <strong>{part.text}</strong> : part.text))}
          </p>
          {figures.filter((figure) => figure.after === index).map((figure) => <Figures ids={[figure.id]} />)}
        </>
      ))
    }
    {
      points.length > 0 && (
        <ul class="course-points">
          {points.map((point) => (
            <li>
              {pieces(point).map((part) => (part.bold ? <strong>{part.text}</strong> : part.text))}
            </li>
          ))}
        </ul>
      )
    }
    {credit && <p class="course-credit">{credit}</p>}
  </div>
  <div class="level-panel" data-panel="detailed" hidden>
    {hasDetail && detailed.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</div>

<script>
  function boot() {
    document.querySelectorAll<HTMLElement>(".levels").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
      const panels = root.querySelectorAll<HTMLElement>("[data-panel]");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const id = tab.dataset.tab;
          tabs.forEach((other) => other.setAttribute("aria-selected", String(other === tab)));
          panels.forEach((panel) => {
            panel.hidden = panel.dataset.panel !== id;
          });
        });
      });
    });
  }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
