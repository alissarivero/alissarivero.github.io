<section class="hero">
  <canvas id="psych-hero" aria-hidden="true"></canvas>
  <p class="hero-caption">Each dot is a person. They gather, the means separate, and a line settles through the noise.</p>
</section>

<script>
  function boot() {
    const canvas = document.getElementById("psych-hero") as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.ready) return;
    canvas.dataset.ready = "1";
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const N = 64;
    const dots = Array.from({ length: N }, (_, i) => {
      const group = i < N / 2 ? 0 : 1;
      return {
        group,
        x: Math.random(),
        y: Math.random(),
        tx: 0,
        ty: 0,
        phase: Math.random() * Math.PI * 2,
      };
    });

    function resize() {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    window.addEventListener("resize", resize);

    function targets(t: number) {
      const cycle = reduced ? 0.72 : (t % 14000) / 14000;
      const gather = cycle < 0.18 ? cycle / 0.18 : cycle > 0.82 ? (1 - cycle) / 0.18 : 1;
      dots.forEach((dot, i) => {
        const col = dot.group === 0 ? 0.3 : 0.7;
        const mean = dot.group === 0 ? 0.62 : 0.38;
        const scatterX = (i * 0.173) % 1;
        const scatterY = (i * 0.291) % 1;
        const jitter = (((i * 17) % 11) - 5) / 28;
        dot.tx = scatterX * (1 - gather) + (col + jitter * 0.35) * gather;
        dot.ty = scatterY * (1 - gather) + (mean + jitter * 0.55) * gather;
      });
      return gather;
    }

    function frame(now: number) {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const gather = targets(now);
      ctx.clearRect(0, 0, width, height);

      const grd = ctx.createLinearGradient(0, 0, width, height);
      grd.addColorStop(0, "#f7f4ef");
      grd.addColorStop(1, "#e7f3f1");
      ctx.fillStyle = grd;
      ctx.fillRect(0, 0, width, height);

      ctx.strokeStyle = "rgba(22,22,22,0.08)";
      ctx.lineWidth = 1;
      for (let g = 1; g < 4; g++) {
        ctx.beginPath();
        ctx.moveTo(28, (height * g) / 4);
        ctx.lineTo(width - 28, (height * g) / 4);
        ctx.stroke();
      }

      if (gather > 0.55) {
        const a = 0.16 + gather * 0.5;
        ctx.strokeStyle = `rgba(15,110,107,${a})`;
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.moveTo(width * 0.12, height * 0.7);
        ctx.lineTo(width * 0.88, height * 0.3);
        ctx.stroke();
        ctx.fillStyle = `rgba(15,110,107,${0.08 * gather})`;
        ctx.beginPath();
        ctx.moveTo(width * 0.12, height * 0.78);
        ctx.lineTo(width * 0.88, height * 0.38);
        ctx.lineTo(width * 0.88, height * 0.22);
        ctx.lineTo(width * 0.12, height * 0.62);
        ctx.closePath();
        ctx.fill();
      }

      dots.forEach((dot) => {
        dot.x += (dot.tx - dot.x) * (reduced ? 1 : 0.06);
        dot.y += (dot.ty - dot.y) * (reduced ? 1 : 0.06);
        const wobble = reduced ? 0 : Math.sin(now / 700 + dot.phase) * (1 - gather) * 4;
        const x = 36 + dot.x * (width - 72);
        const y = 24 + dot.y * (height - 48) + wobble;
        ctx.beginPath();
        ctx.fillStyle = dot.group === 0 ? "#161616" : "#0f6e6b";
        ctx.arc(x, y, gather > 0.8 ? 4.5 : 3.4, 0, Math.PI * 2);
        ctx.fill();
      });

      if (gather > 0.75) {
        [0.3, 0.7].forEach((col, group) => {
          const mean = group === 0 ? 0.62 : 0.38;
          const x = 36 + col * (width - 72);
          const y = 24 + mean * (height - 48);
          ctx.strokeStyle = group === 0 ? "#161616" : "#0f6e6b";
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(x - 36, y);
          ctx.lineTo(x + 36, y);
          ctx.stroke();
        });
      }

      if (!reduced) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
