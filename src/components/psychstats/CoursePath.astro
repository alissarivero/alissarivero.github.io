---
import { MODULES } from "../../data/psychstats/modules";

interface Props {
  current?: string;
  collapsed?: boolean;
  toggle?: boolean;
}

const { current = "", collapsed = false, toggle = true } = Astro.props;
const lessons = MODULES.filter((m) => m.kind === "lesson");
const projects = MODULES.filter((m) => m.kind === "project");
const opener = MODULES.filter((m) => m.parent === "course");
const under = (slug: string) => MODULES.filter((m) => m.parent === slug);
---

<nav id="course-path" class:list={["course-path", { "is-collapsed": collapsed }]} aria-label="Course path">
  {toggle && (
    <button type="button" class="path-toggle" aria-expanded={collapsed ? "false" : "true"}>
      {collapsed ? "Expand path" : "Collapse path"}
    </button>
  )}
  <ol class="trail">
    <li class="unit unit-opener">
      <div class="nodes">
        {opener.map((task) => (
          <a
            class:list={["node", "guide", { here: current === task.slug }]}
            href={task.href}
            data-module={task.slug}
            data-kind="guide"
            aria-current={current === task.slug ? "page" : undefined}
          >
            <span class="bubble">Read</span>
            <span class="node-label">{task.title}</span>
          </a>
        ))}
      </div>
    </li>
    {
      lessons.map((lesson, i) => (
        <li class:list={["unit", { "unit-shut": current ? !under(lesson.slug).some((task) => task.slug === current) && lesson.slug !== current : i > 0 }]}>
          <header class="unit-head">
            <button type="button" class="unit-toggle" aria-expanded={current ? String(under(lesson.slug).some((task) => task.slug === current) || lesson.slug === current) : String(i === 0)}>
            <span>Unit {i + 1}</span>
            <h2>{lesson.title}</h2>
            <p>{lesson.blurb}</p>
            </button>
          </header>
          <div class="nodes">
            {under(lesson.slug).map((task) =>
              task.kind === "page" ? (
                <a
                  class:list={["node", "guide", { here: current === task.slug }]}
                  href={task.href}
                  data-module={task.slug}
                  data-search={`${task.title} ${task.blurb} ${task.levels.overview.join(" ")}`}
                  data-kind="guide"
                  aria-current={current === task.slug ? "page" : undefined}
                >
                  <span class="bubble">Read</span>
                  <span class="node-label">{task.title}</span>
                </a>
              ) : (
                <a
                  class:list={["node", "assignment", { here: current === task.slug }]}
                  href={task.href}
                  data-module={task.slug}
                  data-search={`${task.title} ${task.blurb} ${task.levels.overview.join(" ")}`}
                  data-xp={task.xp}
                  data-kind="check"
                  aria-current={current === task.slug ? "page" : undefined}
                >
                  <span class="bubble" aria-hidden="true">✓</span>
                  <span class="node-label">{task.title}</span>
                </a>
              )
            )}
          </div>
        </li>
      ))
    }
    <li class="unit project-board">
      <header class="unit-head">
        <span>Projects</span>
        <h2>Working with real data</h2>
        <p>These use the lessons together. They sit beside the path, not on it.</p>
      </header>
      <div class="project-cards">
        {projects.map((project) => (
          <a
            class:list={["project-card", { here: current === project.slug }]}
            href={project.href}
            data-module={project.slug}
            data-xp={project.xp}
            data-kind="check"
            aria-current={current === project.slug ? "page" : undefined}
          >
            <span class="project-xp">{project.xp} XP</span>
            <h3 class="project-title">{project.title}</h3>
            <p>{project.blurb}</p>
          </a>
        ))}
      </div>
      <figure class="bridge-fig">
        <svg viewBox="0 0 760 250" role="img" aria-labelledby="bridge-title">
          <title id="bridge-title">Psychology and data science meet in the same study</title>
          <defs>
            <linearGradient id="bridge-wash" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#00539B" stop-opacity="0.16" />
              <stop offset="1" stop-color="#E89923" stop-opacity="0.22" />
            </linearGradient>
          </defs>
          <circle cx="300" cy="118" r="92" fill="#00539B" opacity="0.1" />
          <circle cx="460" cy="118" r="92" fill="#E89923" opacity="0.16" />
          <circle cx="380" cy="118" r="58" fill="url(#bridge-wash)" />
          <g fill="#00539B">
            <circle cx="118" cy="78" r="7" />
            <circle cx="148" cy="104" r="5" />
            <circle cx="126" cy="132" r="6" />
            <circle cx="160" cy="150" r="4.5" />
            <circle cx="102" cy="158" r="5" />
          </g>
          <path d="M108 92c18 8 28 22 22 40" fill="none" stroke="#00539B" stroke-width="1.6" opacity="0.7" />
          <path d="M136 112c16 10 18 28 6 42" fill="none" stroke="#00539B" stroke-width="1.6" opacity="0.45" />
          <g fill="#E89923">
            <circle cx="492" cy="72" r="5" />
            <circle cx="524" cy="98" r="4" />
            <circle cx="500" cy="126" r="5.5" />
            <circle cx="536" cy="142" r="4" />
            <circle cx="508" cy="162" r="5" />
          </g>
          <g fill="#00539B">
            <circle cx="338" cy="96" r="5" />
            <circle cx="362" cy="78" r="4" />
            <circle cx="386" cy="108" r="6" />
            <circle cx="408" cy="86" r="4.5" />
            <circle cx="352" cy="132" r="5" />
            <circle cx="392" cy="146" r="4" />
            <circle cx="418" cy="128" r="5.5" />
            <circle cx="368" cy="164" r="4" />
          </g>
          <path d="M330 156 C 360 132, 400 108, 436 84" fill="none" stroke="#00539B" stroke-width="2.4" stroke-linecap="round" />
          <path d="M330 168 C 360 144, 400 120, 436 96" fill="none" stroke="#E89923" stroke-width="8" stroke-linecap="round" opacity="0.35" />
          <g fill="#E89923">
            <rect x="620" y="150" width="16" height="36" rx="4" />
            <rect x="644" y="116" width="16" height="70" rx="4" />
            <rect x="668" y="88" width="16" height="98" rx="4" />
            <rect x="692" y="130" width="16" height="56" rx="4" opacity="0.55" />
          </g>
          <text x="300" y="228" text-anchor="middle" fill="#00539B" font-size="15" font-weight="700">Psychology</text>
          <text x="460" y="228" text-anchor="middle" fill="#c47d12" font-size="15" font-weight="700">Data science</text>
        </svg>
        <figcaption>The question comes from the study. The record is the data. The work lives where they overlap.</figcaption>
      </figure>
    </li>
  </ol>
</nav>

<script>
  import { loadProgress } from "../../lib/progress";

  function bootPath() {
    document.querySelectorAll<HTMLElement>(".course-path").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const button = root.querySelector<HTMLButtonElement>(".path-toggle");
      const frame = root.closest(".psych-frame");
      root.querySelectorAll<HTMLButtonElement>(".unit-toggle").forEach((toggle) => {
        toggle.addEventListener("click", () => {
          const unit = toggle.closest(".unit");
          const shut = unit?.classList.toggle("unit-shut");
          toggle.setAttribute("aria-expanded", String(!shut));
        });
      });
      button?.addEventListener("click", () => {
        const collapsed = root.classList.toggle("is-collapsed");
        frame?.classList.toggle("path-collapsed", collapsed);
        if (button) {
          button.textContent = collapsed ? "Expand path" : "Collapse path";
          button.setAttribute("aria-expanded", String(!collapsed));
        }
      });
    });
  }

  async function markProgress() {
    const nodes = [...document.querySelectorAll<HTMLElement>(".course-path .node, .course-path .project-card")];
    if (nodes.length === 0 || nodes[0].dataset.marked) return;
    nodes[0].dataset.marked = "1";
    const rows = await loadProgress();
    const done = new Map(rows.map((row) => [row.slug, row]));
    const line = document.getElementById("xp-line");
    if (line && !line.dataset.ready) {
      line.dataset.ready = "1";
      line.textContent = `${rows.reduce((sum, row) => sum + (row.status === "checked" ? row.xp : 0), 0)} XP`;
      const badgeRow = document.getElementById("badge-row");
      if (badgeRow && badgeRow.childElementCount === 0) {
        for (const badge of new Set(rows.flatMap((row) => row.badges))) {
          const chip = document.createElement("span");
          chip.className = "badge";
          chip.textContent = badge;
          badgeRow.appendChild(chip);
        }
      }
    }
    let next: HTMLElement | null = null;
    for (const node of nodes) {
      const row = done.get(node.dataset.module || "");
      if (row?.status === "checked") node.classList.add("done");
      else if (row) node.classList.add("started");
      if (!next && row?.status !== "checked") next = node;
    }
    next?.classList.add("up-next");
    const cont = document.getElementById("continue");
    if (cont && next) cont.setAttribute("href", next.getAttribute("href") || "/psychstats/");
  }

  bootPath();
  void markProgress();
  document.addEventListener("astro:page-load", () => {
    bootPath();
    void markProgress();
  });
</script>
