---
import { MODULES } from "../../data/psychstats/modules";

interface Props {
  current?: string;
  collapsed?: boolean;
  toggle?: boolean;
}

const { current = "", collapsed = false, toggle = true } = Astro.props;
const lessons = MODULES.filter((m) => m.kind === "lesson");
const projects = MODULES.filter((m) => m.kind === "project");
const opener = MODULES.filter((m) => m.parent === "course");
const under = (slug: string) => MODULES.filter((m) => m.parent === slug);
---

<nav id="course-path" class:list={["course-path", { "is-collapsed": collapsed }]} aria-label="Course path">
  {toggle && (
    <button type="button" class="path-toggle" aria-expanded={collapsed ? "false" : "true"}>
      {collapsed ? "Expand path" : "Collapse path"}
    </button>
  )}
  <ol class="trail">
    <li class="unit unit-opener">
      <div class="nodes">
        {opener.map((task) => (
          <a
            class:list={["node", "guide", { here: current === task.slug }]}
            href={task.href}
            data-module={task.slug}
            data-kind="guide"
            aria-current={current === task.slug ? "page" : undefined}
          >
            <span class="bubble">Read</span>
            <span class="node-label">{task.title}</span>
          </a>
        ))}
      </div>
    </li>
    {
      lessons.map((lesson, i) => (
        <li class="unit">
          <header class="unit-head">
            <span>Unit {i + 1}</span>
            <h2>{lesson.title}</h2>
            <p>{lesson.blurb}</p>
          </header>
          <div class="nodes">
            {under(lesson.slug).map((task) =>
              task.kind === "page" ? (
                <a
                  class:list={["node", "guide", { here: current === task.slug }]}
                  href={task.href}
                  data-module={task.slug}
                  data-kind="guide"
                  aria-current={current === task.slug ? "page" : undefined}
                >
                  <span class="bubble">Read</span>
                  <span class="node-label">{task.title}</span>
                </a>
              ) : (
                <a
                  class:list={["node", "assignment", { here: current === task.slug }]}
                  href={task.href}
                  data-module={task.slug}
                  data-xp={task.xp}
                  data-kind="check"
                  aria-current={current === task.slug ? "page" : undefined}
                >
                  <span class="bubble">{task.xp}</span>
                  <span class="node-label">{task.title}</span>
                </a>
              )
            )}
          </div>
        </li>
      ))
    }
    <li class="unit project-board">
      <header class="unit-head">
        <span>Projects</span>
        <h2>Longer work</h2>
        <p>These use the lessons together. They sit beside the path, not on it.</p>
      </header>
      <div class="project-cards">
        {projects.map((project) => (
          <a
            class:list={["project-card", { here: current === project.slug }]}
            href={project.href}
            data-module={project.slug}
            data-xp={project.xp}
            data-kind="check"
            aria-current={current === project.slug ? "page" : undefined}
          >
            <span class="project-xp">{project.xp} XP</span>
            <h3 class="project-title">{project.title}</h3>
            <p>{project.blurb}</p>
          </a>
        ))}
      </div>
    </li>
  </ol>
</nav>

<script>
  import { loadProgress } from "../../lib/progress";

  function bootPath() {
    document.querySelectorAll<HTMLElement>(".course-path").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";
      const button = root.querySelector<HTMLButtonElement>(".path-toggle");
      const frame = root.closest(".psych-frame");
      button?.addEventListener("click", () => {
        const collapsed = root.classList.toggle("is-collapsed");
        frame?.classList.toggle("path-collapsed", collapsed);
        if (button) {
          button.textContent = collapsed ? "Expand path" : "Collapse path";
          button.setAttribute("aria-expanded", String(!collapsed));
        }
      });
    });
  }

  async function markProgress() {
    const nodes = [...document.querySelectorAll<HTMLElement>(".course-path .node, .course-path .project-card")];
    if (nodes.length === 0 || nodes[0].dataset.marked) return;
    nodes[0].dataset.marked = "1";
    const rows = await loadProgress();
    const done = new Map(rows.map((row) => [row.slug, row]));
    const line = document.getElementById("xp-line");
    if (line && !line.dataset.ready) {
      line.dataset.ready = "1";
      line.textContent = `${rows.reduce((sum, row) => sum + (row.status === "checked" ? row.xp : 0), 0)} XP`;
      const badgeRow = document.getElementById("badge-row");
      if (badgeRow && badgeRow.childElementCount === 0) {
        for (const badge of new Set(rows.flatMap((row) => row.badges))) {
          const chip = document.createElement("span");
          chip.className = "badge";
          chip.textContent = badge;
          badgeRow.appendChild(chip);
        }
      }
    }
    let next: HTMLElement | null = null;
    for (const node of nodes) {
      const row = done.get(node.dataset.module || "");
      if (row?.status === "checked") node.classList.add("done");
      else if (row) node.classList.add("started");
      if (!next && row?.status !== "checked") next = node;
    }
    next?.classList.add("up-next");
    const cont = document.getElementById("continue");
    if (cont && next) cont.setAttribute("href", next.getAttribute("href") || "/psychstats/");
  }

  bootPath();
  void markProgress();
  document.addEventListener("astro:page-load", () => {
    bootPath();
    void markProgress();
  });
</script>
