---
import { MODULES } from "../../data/psychstats/modules";

const { current } = Astro.props;
const lessons = MODULES.filter((m) => m.kind === "lesson");
const projects = MODULES.filter((m) => m.kind === "project");
const under = (slug: string) => MODULES.filter((m) => m.parent === slug);
---

<nav class="psych-nav" aria-label="Course">
  <a class="nav-home" href="/psychstats/" aria-current={current === "hub" ? "page" : undefined}>Home</a>
  <p class="nav-label">Lessons</p>
  <div class="nav-rail">
    {
      lessons.map((lesson, i) => (
        <div class="nav-stop">
          <a href={lesson.href} aria-current={current === lesson.slug ? "page" : undefined}>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <span>{lesson.short}</span>
          </a>
          {under(lesson.slug).map((task) => (
            <a class="nested" href={task.href} aria-current={current === task.slug ? "page" : undefined}>
              <span>{task.short}</span>
            </a>
          ))}
        </div>
      ))
    }
  </div>
  <p class="nav-label">Projects</p>
  <div class="nav-rail nav-rail-quests">
    {
      projects.map((project, i) => (
        <a href={project.href} aria-current={current === project.slug ? "page" : undefined}>
          <span class="num">{String(i + 1).padStart(2, "0")}</span>
          <span>{project.short}</span>
        </a>
      ))
    }
  </div>
  <p class="nav-label">Class</p>
  <div class="nav-class">
    <a href="/psychstats/portal/" aria-current={current === "portal" ? "page" : undefined}>Portal</a>
    <a href="/psychstats/teach/" aria-current={current === "teach" ? "page" : undefined}>Teach</a>
  </div>
</nav>
