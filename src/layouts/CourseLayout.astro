---
import BaseHead from "../components/BaseHead.astro";
import CoursePath from "../components/psychstats/CoursePath.astro";
import "../styles/psych.css";

const { title, description, current = "hub" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,680&family=Nunito:ital,wght@0,420;0,620;0,750;1,420&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="psych-shell">
    <header class="psych-top">
      <a class="psych-mark" href="/psychstats/">Psych Stats</a>
      <p class="psych-tag">Statistics, from a psychologist's perspective</p>
      <div class="psych-actions">
        <a class="psych-join" href="/psychstats/portal/">Join / create a course</a>
        <a class="psych-exit" id="psych-account" href="/psychstats/portal/">Login</a>
      </div>
    </header>
    <div class:list={["psych-frame", { "psych-home": current === "hub", "path-collapsed": current !== "hub" }]}>
      {current !== "hub" && <CoursePath current={current} collapsed />}
      <main class="psych-main">
        <slot />
      </main>
    </div>
    <footer class="psych-footer">
      <p>Anti-Racist Community, Department of Psychology &amp; Neuroscience at Duke University</p>
      <p>
        For questions or feedback, please reach out to <a href="mailto:pnarc@duke.edu">pnarc@duke.edu</a>
      </p>
    </footer>
    <script>
      import { getSupabase } from "../lib/supabase";

      function bootAccount() {
        const link = document.getElementById("psych-account");
        if (!link || link.dataset.ready) return;
        link.dataset.ready = "1";

        async function paint() {
          const sb = getSupabase();
          if (!sb) {
            link.textContent = "Login";
            link.setAttribute("href", "/psychstats/portal/");
            return;
          }
          const { data } = await sb.auth.getUser();
          const user = data.user;
          if (!user) {
            link.textContent = "Login";
            link.setAttribute("href", "/psychstats/portal/");
            return;
          }
          const { data: profile } = await sb.from("profiles").select("role").eq("id", user.id).maybeSingle();
          const instructor = profile?.role === "instructor";
          link.textContent = instructor ? "Instructor" : "Student";
          link.setAttribute("href", instructor ? "/psychstats/teach/" : "/psychstats/portal/");
        }

        void paint();
        window.addEventListener("psychstats-auth", () => void paint());
      }

      bootAccount();
      document.addEventListener("astro:page-load", bootAccount);
    </script>
  </body>
</html>
