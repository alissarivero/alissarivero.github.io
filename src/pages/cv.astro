---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="CV" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-5xl w-full font-bold">CV</div>
  </div>

     <div class="mx-auto mt-4 mb-4 h-[2px] w-7/8 bg-white opacity-80"></div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Duke University"
      subtitle="Ph.D. in Developmental Psychology"
      caption ="2026-present | Advisors: Dr. Dorsa Amir and Dr. Tamar Kushnir"
    />
    <TimeLineElement
      title="Duke University"
      subtitle="B.A. in Psychology, Minor in Evolutionary Anthropology"
      caption ="2021-2025 | Advisors: Dr. Michael Tomasello"
    />
    <TimeLineElement
      title="International Baccalaureate Diploma"
      subtitle="Washington-Liberty High School"
      caption="2017-2021 | Arlington, VA"
    />
  </div>

       <div class="mx-auto mt-4 mb-4 h-[2px] w-7/8 bg-white opacity-80"></div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Research Highlights</div>
  </div>

     <div class="mt-8">
      <a href="https://docs.google.com/document/d/1pGDpktHWTOFIAoS9j6Z6NZcigpKv67fye2jeIm_RL6U/edit?usp=sharing" target="_blank" class="btn btn-outline ml-5">
        Click here for access to my full CV 
      </a>

      <div class="flex flex-col sm:flex-row justify-center gap-6 mt-10">
    <img
      src="/baby.webp"
      alt="Baby Alissa"
      class="rounded-xl shadow-md object-cover w-full sm:w-1/2"
      loading="lazy"
    />
    <img
      src="/child.webp"
      alt="Young Alissa"
      class="rounded-xl shadow-md object-cover w-full sm:w-1/2"
      loading="lazy"
    />
  </div>
  </div>