---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="CV" sideBarActiveItemID="cv">

  <div class="mb-6">
    <div class="text-5xl font-bold text-white">CV</div>
  </div>

  <div class="mx-auto mt-4 mb-8 h-[2px] w-7/8 bg-white opacity-80"></div>

  <div class="mb-5">
    <div class="text-3xl font-bold text-white">Education</div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,700px)_220px] gap-8 items-start">

    <div class="time-line-container grid gap-4 mb-6">
      <TimeLineElement
        title="Duke University"
        subtitle="Ph.D. in Developmental Psychology"
        caption="2026–present | Advisors: Dr. Dorsa Amir and Dr. Tamar Kushnir"
      />
      <TimeLineElement
        title="Duke University"
        subtitle="B.A. in Psychology, Minor in Evolutionary Anthropology"
        caption="2021–2025 | Advisor: Dr. Michael Tomasello"
      />
    </div>

    <div class="lg:sticky lg:top-28">
      <a
        href="https://docs.google.com/document/d/1pGDpktHWTOFIAoS9j6Z6NZcigpKv67fye2jeIm_RL6U/edit?usp=sharing"
        target="_blank"
        class="btn btn-outline w-full text-center"
      >
        View Full CV →
      </a>
    </div>

  </div>

  <div class="flex flex-col sm:flex-row justify-center gap-6 mt-8">
    <img
      src="/baby.webp"
      alt="Baby Alissa"
      class="rounded-xl shadow-md object-cover w-full sm:w-1/2"
      loading="lazy"
    />
    <img
      src="/child.webp"
      alt="Young Alissa"
      class="rounded-xl shadow-md object-cover w-full sm:w-1/2"
      loading="lazy"
    />
  </div>

</BaseLayout>