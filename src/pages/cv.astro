---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="CV" sideBarActiveItemID="cv">
  <div class="max-w-5xl mx-auto">
    <div class="mb-6">
      <div class="text-5xl font-bold text-white">CV</div>
    </div>

    <div class="mx-auto mt-4 mb-8 h-[2px] w-full bg-white opacity-80"></div>

    <div class="mb-5">
      <div class="text-3xl font-bold text-white">Education</div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-10 items-start">
      <div class="time-line-container grid gap-4 max-w-2xl">
        <TimeLineElement
          title="Duke University"
          subtitle="Ph.D. in Developmental Psychology"
          caption="2026–present | Advisors: Dr. Dorsa Amir and Dr. Tamar Kushnir"
        />
        <TimeLineElement
          title="Duke University"
          subtitle="B.A. in Psychology, Minor in Evolutionary Anthropology"
          caption="2021–2025 | Advisor: Dr. Michael Tomasello"
        />
      </div>

      <div class="flex justify-start lg:justify-center pt-2">
        <a
          href="https://docs.google.com/document/d/1pGDpktHWTOFIAoS9j6Z6NZcigpKv67fye2jeIm_RL6U/edit?usp=sharing"
          target="_blank"
          class="group block w-[280px] rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm px-6 py-5 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:bg-white/10"
        >
          <div class="mb-2 text-xs uppercase tracking-[0.18em] text-white/50">
            Curriculum Vitae
          </div>
          <div class="flex items-center gap-2 text-xl font-semibold text-white">
            View Full CV
            <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </div>
        </a>
      </div>
    </div>

    <div class="mx-auto mt-8 mb-6 h-[2px] w-full bg-white opacity-80"></div>

   <div class="flex flex-col sm:flex-row justify-center items-start gap-6">
  
  <div class="w-full sm:w-[48%] h-[500px] overflow-hidden rounded-xl shadow-md">
    <img
      src="/baby.webp"
      alt="Baby Alissa"
      class="w-full h-full object-cover"
      loading="lazy"
    />
  </div>

  <div class="w-full sm:w-[48%] h-[500px] overflow-hidden rounded-xl shadow-md">
    <img
      src="/child.webp"
      alt="Young Alissa"
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
  </div>

</div>
</BaseLayout>