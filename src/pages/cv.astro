      width: 100% !important;
    }
  </style>

  <div class="w-full h-screen overflow-hidden">
    <iframe
      src="https://docs.google.com/document/d/e/2PACX-1vRH5g06LDnaVPF2hrc2Knvgh8E6TzC3x7W0ysO4uYue3a-HUAKOH3dYvhPHVOqE130mcTxMdt7Fyy7p/pub?embedded=true"
