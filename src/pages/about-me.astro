---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Posters" sideBarActiveItemID="posters">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Posters</div>
  </div>

  <div class="flex flex-col sm:flex-row justify-center gap-6 mt-10">
    <img
      src="/baby.webp"
      alt="Baby Alissa"
      class="rounded-xl shadow-md object-cover w-full sm:w-1/2"
      loading="lazy"
    />
    <img
      src="/child.webp"
      alt="Young Alissa"
      class="rounded-xl shadow-md object-cover w-full sm:w-1/2"
      loading="lazy"
    />
  </div>
</BaseLayout>