---
import CourseLayout from "../../layouts/CourseLayout.astro";
import Hero from "../../components/psychstats/Hero.astro";
import { MODULES } from "../../data/psychstats/modules";

const lessons = MODULES.filter((m) => m.kind === "lesson");
const projects = MODULES.filter((m) => m.kind === "project");
const under = (slug: string) => MODULES.filter((m) => m.parent === slug);
---

<CourseLayout title="Psych Stats" description="Statistics for psychology, taught without a mathematical track." current="hub">
  <Hero />
  <p class="psych-kicker">Psych Stats</p>
  <h1>Statistics, from a psychologist’s chair</h1>
  <p class="psych-lead">
    Nine lessons. Each assignment sits under the lesson it practices. Four projects at the end. No math track.
  </p>
  <p class="psych-note" id="xp-line">Points save on this device. A class can also keep them in the portal.</p>
  <div class="badges" id="badge-row"></div>
  <section class="course-group">
    <h2>Lessons</h2>
    <p class="psych-note">Read in order. The tasks underneath are the practice, and the points.</p>
    <div class="path">
      {
        lessons.map((lesson, i) => (
          <>
            <a href={lesson.href}>
              <span class="idx">{String(i + 1).padStart(2, "0")}</span>
              <span>
                <h2>{lesson.title}</h2>
                <p>{lesson.blurb}</p>
                <p class="meta">About {lesson.minutes} minutes</p>
              </span>
              <span class="chip">Read</span>
            </a>
            {under(lesson.slug).map((task) => (
              <a class="nested-card" href={task.href} data-module={task.slug}>
                <span class="idx">·</span>
                <span>
                  <h2>{task.title}</h2>
                  <p>{task.blurb}</p>
                  <p class="meta">
                    About {task.minutes} minutes · {task.xp} points
                  </p>
                </span>
                <span class="chip progress-chip">Not started</span>
              </a>
            ))}
          </>
        ))
      }
    </div>
  </section>
  <section class="course-group">
    <h2>Projects</h2>
    <p class="psych-note">Longer work that uses the lessons together.</p>
    <div class="path">
      {
        projects.map((project, i) => (
          <a href={project.href} data-module={project.slug}>
            <span class="idx">{String(i + 1).padStart(2, "0")}</span>
            <span>
              <h2>{project.title}</h2>
              <p>{project.blurb}</p>
              <p class="meta">
                About {project.minutes} minutes · {project.xp} points
              </p>
            </span>
            <span class="chip progress-chip">Not started</span>
          </a>
        ))
      }
    </div>
  </section>
</CourseLayout>

<script>
  import { loadProgress } from "../../lib/progress";

  async function boot() {
    const line = document.getElementById("xp-line");
    if (!line || line.dataset.ready) return;
    line.dataset.ready = "1";
    const rows = await loadProgress();
    const total = rows.reduce((sum, row) => sum + (row.status === "checked" ? row.xp : 0), 0);
    const badges = Array.from(new Set(rows.flatMap((row) => row.badges)));
    if (total > 0) line.textContent = `${total} points on the assignments and projects you have checked.`;
    const badgeRow = document.getElementById("badge-row");
    if (badgeRow) {
      for (const badge of badges) {
        const chip = document.createElement("span");
        chip.className = "badge";
        chip.textContent = badge;
        badgeRow.appendChild(chip);
      }
    }
    for (const row of rows) {
      const chip = document.querySelector(`[data-module="${row.slug}"] .progress-chip`);
      if (!chip) continue;
      chip.textContent = row.status === "checked" ? "Checked" : "Started";
      chip.classList.add(row.status === "checked" ? "badge-success" : "badge-warning");
    }
  }
  void boot();
  document.addEventListener("astro:page-load", () => {
    void boot();
  });
</script>
