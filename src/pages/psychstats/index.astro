---
import CourseLayout from "../../layouts/CourseLayout.astro";
import { MODULES } from "../../data/psychstats/modules";

const groups = [
  { id: "lesson", kicker: "Lessons", lead: "Read these in order. They carry no points." },
  { id: "assignment", kicker: "Assignments", lead: "Short R tasks. Points land here." },
  { id: "project", kicker: "Projects", lead: "Longer work that uses the lessons together." },
] as const;
---

<CourseLayout title="Psych Stats" description="Statistics for psychology, taught without a mathematical track." current="hub">
  <p class="psych-kicker">Psych Stats</p>
  <h1>Statistics, from a psychologist’s chair</h1>
  <p class="psych-lead">
    Eight lessons, twelve R assignments, and four projects. No math track. The sentence is about the behavior.
  </p>
  <p class="psych-note" id="xp-line">Points save on this device. A class can also keep them in the portal.</p>
  <div class="badges" id="badge-row"></div>
  {
    groups.map((group) => (
      <section class="course-group">
        <h2>{group.kicker}</h2>
        <p class="psych-note">{group.lead}</p>
        <div class="path">
          {MODULES.filter((m) => m.kind === group.id).map((m, i) => (
            <a href={m.href} data-module={m.slug}>
              <span class="idx">{String(i + 1).padStart(2, "0")}</span>
              <span>
                <h2>{m.title}</h2>
                <p>{m.blurb}</p>
                <p class="meta">
                  About {m.minutes} minutes
                  {m.xp > 0 ? ` · ${m.xp} points` : ""}
                </p>
              </span>
              {m.xp > 0 ? <span class="chip progress-chip">Not started</span> : <span class="chip">Read</span>}
            </a>
          ))}
        </div>
      </section>
    ))
  }
</CourseLayout>

<script>
  import { loadProgress } from "../../lib/progress";

  async function boot() {
    const line = document.getElementById("xp-line");
    if (!line || line.dataset.ready) return;
    line.dataset.ready = "1";
    const rows = await loadProgress();
    const total = rows.reduce((sum, row) => sum + (row.status === "checked" ? row.xp : 0), 0);
    const badges = Array.from(new Set(rows.flatMap((row) => row.badges)));
    if (total > 0) line.textContent = `${total} points on the assignments and projects you have checked.`;
    const badgeRow = document.getElementById("badge-row");
    if (badgeRow) {
      for (const badge of badges) {
        const chip = document.createElement("span");
        chip.className = "badge";
        chip.textContent = badge;
        badgeRow.appendChild(chip);
      }
    }
    for (const row of rows) {
      const chip = document.querySelector(`[data-module="${row.slug}"] .progress-chip`);
      if (!chip) continue;
      chip.textContent = row.status === "checked" ? "Checked" : "Started";
      chip.classList.add(row.status === "checked" ? "badge-success" : "badge-warning");
    }
  }
  void boot();
  document.addEventListener("astro:page-load", () => {
    void boot();
  });
</script>
