---
import CourseLayout from "../../layouts/CourseLayout.astro";
import Hero from "../../components/psychstats/Hero.astro";
import CoursePath from "../../components/psychstats/CoursePath.astro";
import { MODULES } from "../../data/psychstats/modules";

const opener = MODULES.find((m) => m.parent === "course");
const firstLesson = MODULES.find((m) => m.kind === "lesson");
const firstStep = opener ?? MODULES.find((m) => m.parent === firstLesson?.slug);
---

<CourseLayout title="Psych Stats" description="Statistics for psychology, taught without a mathematical track." current="hub">
  <section class="welcome">
    <h1>Welcome to Intro Psych Stats!</h1>
    <p>
      We have created this free online resource to help make the statistics that psychologists use every day more
      accessible to students and trainees. No statistical knowledge or experience in R required!
    </p>
    <div class="welcome-actions">
      <a class="start-course" href="#sign-up">Start the course</a>
      <a id="continue" class="continue" href={firstStep?.href ?? "#course-path"} hidden>Continue where you left off</a>
      <button type="button" class="topic-search" id="topic-search-btn">Search for a specific topic</button>
    </div>
    <form id="topic-search" class="topic-search-form" hidden>
      <label for="topic-q">Topic</label>
      <input id="topic-q" type="search" placeholder="Try regression, t-test, R…" autocomplete="off" />
      <div id="topic-results" class="topic-results" hidden></div>
    </form>
  </section>
  <Hero />
  <section class="welcome welcome-after" id="sign-up">
    <p>
      You can <a href="/psychstats/portal/">sign up</a> to save your progress, or
      <a href="/psychstats/portal/">join</a> / <a href="/psychstats/teach/">create</a> a course if you are a student or
      instructor. If you do not want to sign up, all materials are freely accessible.
    </p>
  </section>
  <div class="scorebar">
    <div>
      <p class="psych-kicker">Your path</p>
      <h2>Statistics, one step at a time</h2>
    </div>
    <div class="scorebar-side">
      <p id="xp-line" class="xp-total">0 XP</p>
    </div>
  </div>
  <div class="badges" id="badge-row"></div>
  <CoursePath toggle={false} />
  <div class="edge-pattern" aria-hidden="true">
    <svg viewBox="0 0 1440 130" preserveAspectRatio="xMidYMax slice">
