---
import CourseLayout from "../../layouts/CourseLayout.astro";
import Hero from "../../components/psychstats/Hero.astro";
import CoursePath from "../../components/psychstats/CoursePath.astro";
import { MODULES } from "../../data/psychstats/modules";

const opener = MODULES.find((m) => m.parent === "course");
const firstLesson = MODULES.find((m) => m.kind === "lesson");
const firstStep = opener ?? MODULES.find((m) => m.parent === firstLesson?.slug);
---

<CourseLayout title="Psych Stats" description="Statistics for psychology, taught without a mathematical track." current="hub">
  <section class="welcome">
    <h1>Welcome to Intro Psych Stats!</h1>
    <p>
      We have created this free online resource to help make the statistics that psychologists use every day more
      accessible to students and trainees. No statistical knowledge or experience in R required!
    </p>
    <div class="welcome-actions">
      <a class="start-course" href="#sign-up">Start the course</a>
      <button type="button" class="topic-search" id="topic-search-btn">Search for a specific topic</button>
    </div>
    <form id="topic-search" class="topic-search-form" hidden>
      <label for="topic-q">Topic</label>
      <input id="topic-q" type="search" placeholder="Try regression, t-test, R…" autocomplete="off" />
      <div id="topic-results" class="topic-results" hidden></div>
    </form>
  </section>
  <Hero />
  <section class="welcome welcome-after" id="sign-up">
    <p>
      You can <a href="/psychstats/portal/">sign up</a> to save your progress, or
      <a href="/psychstats/portal/">join</a> / <a href="/psychstats/teach/">create</a> a course if you are a student or
      instructor. If you do not want to sign up, all materials are freely accessible.
    </p>
  </section>
  <div class="scorebar">
    <div>
      <p class="psych-kicker">Your path</p>
      <h2>Statistics, one step at a time</h2>
    </div>
    <div class="scorebar-side">
      <p id="xp-line" class="xp-total">0 XP</p>
      <a id="continue" class="continue" href={firstStep?.href ?? "#course-path"}>Continue</a>
    </div>
  </div>
  <div class="badges" id="badge-row"></div>
  <CoursePath toggle={false} />
</CourseLayout>

<script>
  function bootTopicSearch() {
    const open = document.getElementById("topic-search-btn");
    const form = document.getElementById("topic-search");
    const input = document.getElementById("topic-q") as HTMLInputElement | null;
    if (!open || !form || !input || open.dataset.ready) return;
    open.dataset.ready = "1";

    const results = document.getElementById("topic-results");
    if (!results) return;

    const topics = () =>
      [...document.querySelectorAll<HTMLElement>("#course-path .node")].map((node) => ({
        title: node.querySelector(".node-label")?.textContent?.trim() || "",
        href: node.getAttribute("href") || "#course-path",
        node,
      }));

    const paintPath = (q: string) => {
      topics().forEach(({ title, node }) => {
        node.classList.toggle("topic-miss", q.length > 0 && !title.toLowerCase().includes(q));
      });
    };

    const paintSuggestions = () => {
      const q = input.value.trim().toLowerCase();
      results.replaceChildren();
      if (!q) {
        results.hidden = true;
        paintPath("");
        return;
      }
      const matches = topics().filter(({ title }) => title.toLowerCase().includes(q));
      matches.slice(0, 6).forEach(({ title, href }) => {
        const link = document.createElement("a");
        link.href = href;
        link.textContent = title;
        results.appendChild(link);
      });
      if (matches.length === 0) {
        const empty = document.createElement("p");
        empty.textContent = "No topics match that search.";
        results.appendChild(empty);
      }
      const all = document.createElement("button");
      all.type = "button";
      all.className = "topic-see-all";
      all.textContent = matches.length ? `See all ${matches.length} on the path` : "See the path";
      all.addEventListener("click", () => {
        paintPath(q);
        document.getElementById("course-path")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      results.appendChild(all);
      results.hidden = false;
    };

    open.addEventListener("click", () => {
      form.hidden = false;
      input.focus({ preventScroll: true });
    });
    form.addEventListener("submit", (event) => event.preventDefault());
    input.addEventListener("input", paintSuggestions);
  }

  bootTopicSearch();
  document.addEventListener("astro:page-load", bootTopicSearch);
</script>
