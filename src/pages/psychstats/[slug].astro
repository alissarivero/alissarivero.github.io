---
import CourseLayout from "../../layouts/CourseLayout.astro";
import RPlayground from "../../components/psychstats/RPlayground.astro";
import Levels from "../../components/psychstats/Levels.astro";
import TestFlow from "../../components/psychstats/TestFlow.astro";
import ShotSubmit from "../../components/psychstats/ShotSubmit.astro";
import { MODULES, REDIRECTS } from "../../data/psychstats/modules";

export function getStaticPaths() {
  return [
    ...MODULES.map((module) => ({
      params: { slug: module.slug },
      props: { module, redirect: "" },
    })),
    ...REDIRECTS.map((redirect) => ({
      params: { slug: redirect.slug },
      props: { module: undefined, redirect: redirect.to },
    })),
  ];
}

const { module, redirect } = Astro.props;
const steps = MODULES.filter((item) => item.kind === "page" || item.kind === "assignment" || item.kind === "project");
const stepIndex = steps.findIndex((item) => item.slug === module?.slug);
const nextStep = stepIndex >= 0 ? steps[stepIndex + 1] : undefined;
const away = redirect || "";
const unitPages = module ? MODULES.filter((item) => item.parent === module.slug && item.kind !== "lesson") : [];
const kicker =
  module?.kind === "assignment"
    ? "Assignment"
    : module?.kind === "project"
      ? "Project"
      : module?.kind === "page"
        ? "In this lesson"
        : "Lesson";
---

{
  away ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0;url=${away}`} />
        <title>Moved</title>
        <link rel="canonical" href={away} />
      </head>
      <body>
        <p>
          This page has moved. <a href={away}>Continue</a>.
        </p>
      </body>
    </html>
  ) : (
    <CourseLayout title={module.title} description={module.blurb} current={module.slug}>
      <article>
        <p class="psych-kicker">{kicker}</p>
        <h1>{module.title}</h1>
        {(module.video || module.videoSlot) && (
          <figure class="lesson-video">
            {module.video ? (
              <iframe src={module.video} title={module.videoSlot || module.title} allow="fullscreen" />
            ) : (
              <p>A short video will go here: {module.videoSlot}</p>
            )}
          </figure>
        )}
        {module.kind === "lesson" ? (
          <>
            <p>{module.blurb}</p>
            {unitPages.length > 0 && (
              <ul class="unit-contents">
                {unitPages.map((item) => (
                  <li>
                    <a href={item.href}>{item.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <Levels overview={module.levels.overview} detailed={module.levels.detailed} points={module.levels.points} credit={module.levels.credit} figures={module.figures} />
        )}
        {module.slug === "introduction-to-course" && (
          <div class="path-key" aria-label="How to read the path">
            <div class="key-item">
              <span class="key-dot lesson">Read</span>
              <span>Lessons</span>
            </div>
            <div class="key-item">
              <span class="key-dot task" aria-hidden="true">✓</span>
              <span>Assignments</span>
            </div>
          </div>
        )}
        {module.datasetNote && (
          <aside class="dataset-note">
            <span>{module.datasetNote}</span>
          </aside>
        )}
        {module.showFlow && <TestFlow />}
        {module.slug === "r-setup" && <ShotSubmit />}
        {module.starter && (
          <RPlayground
            slug={module.slug}
            starter={module.starter}
            setup={module.setup || ""}
            check={module.check || ""}
            checkHint={module.checkHint || ""}
            xp={module.xp}
            badge={module.badge}
          />
        )}
        <p class="self-check">
          <button
            type="button"
            id="mark-complete"
            data-slug={module.slug}
            data-xp={module.xp}
            data-badge={module.badge || ""}
            data-gated={module.starter && module.check ? "1" : undefined}
            disabled={Boolean(module.starter && module.check)}
          >
            Mark as completed
          </button>
          <span id="mark-status" role="status"></span>
          {nextStep && (
            <a id="next-step" class="next-step" href={nextStep.href} hidden>
              Next
            </a>
          )}
        </p>
      </article>
    </CourseLayout>
  )
}

<script>
  import { loadProgress, saveProgress } from "../../lib/progress";

  function paint(button: HTMLButtonElement, done: boolean) {
    button.dataset.done = done ? "1" : "0";
    button.textContent = done ? "Mark as not completed" : "Mark as completed";
    button.classList.toggle("is-done", done);
    const next = document.getElementById("next-step");
    if (next) next.hidden = !done;
    const node = document.querySelector<HTMLElement>(`#course-path [data-module="${button.dataset.slug}"]`);
    node?.classList.toggle("done", done);
  }

  async function boot() {
    const button = document.getElementById("mark-complete") as HTMLButtonElement | null;
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "1";
    const rows = await loadProgress();
    const current = rows.find((row) => row.slug === button.dataset.slug);
    const doneNow = current?.status === "checked";
    paint(button, doneNow);
    if (button.dataset.gated === "1") button.disabled = !doneNow;
    document.addEventListener("psychstats-output", (event) => {
      const detail = (event as CustomEvent<{ slug: string; ok: boolean }>).detail;
      if (!detail || detail.slug !== button.dataset.slug || button.dataset.gated !== "1") return;
      if (button.dataset.done === "1") return;
      button.disabled = !detail.ok;
      const note = document.getElementById("mark-status");
      if (note) {
        note.textContent = detail.ok
          ? "That output is right. You can mark this complete."
          : "That output is not the one this page is looking for yet.";
      }
    });
    button.addEventListener("click", async () => {
      const done = button.dataset.done !== "1";
      if (done && button.dataset.gated === "1" && button.disabled) return;
      const saved = await saveProgress(
        {
          slug: button.dataset.slug || "",
          status: done ? "checked" : "started",
          xp: done ? Number(button.dataset.xp || 0) : 0,
          badges: done && button.dataset.badge ? [button.dataset.badge] : [],
        },
        true
      );
      paint(button, done);
      if (!done && button.dataset.gated === "1") button.disabled = true;
      const status = document.getElementById("mark-status");
      if (status) {
        const where = saved.remote ? "Saved to your account." : "Saved on this device.";
        status.textContent = done ? `Marked completed. ${where}` : `Marked not completed. ${where}`;
      }
    });
  }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
