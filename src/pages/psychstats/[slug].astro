---
import CourseLayout from "../../layouts/CourseLayout.astro";
import RPlayground from "../../components/psychstats/RPlayground.astro";
import Levels from "../../components/psychstats/Levels.astro";
import TestFlow from "../../components/psychstats/TestFlow.astro";
import ShotSubmit from "../../components/psychstats/ShotSubmit.astro";
import { MODULES, REDIRECTS } from "../../data/psychstats/modules";

export function getStaticPaths() {
  return [
    ...MODULES.map((module) => ({
      params: { slug: module.slug },
      props: { module, redirect: "" },
    })),
    ...REDIRECTS.map((redirect) => ({
      params: { slug: redirect.slug },
      props: { module: undefined, redirect: redirect.to },
    })),
  ];
}

const { module, redirect } = Astro.props;
const away = redirect || (module?.kind === "lesson" ? "/psychstats/#course-path" : "");
const kicker =
  module?.kind === "assignment"
    ? "Assignment"
    : module?.kind === "project"
      ? "Project"
      : module?.kind === "page"
        ? "In this lesson"
        : "Lesson";
---

{
  away ? (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0;url=${away}`} />
        <title>Moved</title>
        <link rel="canonical" href={away} />
      </head>
      <body>
        <p>
          This page has moved. <a href={away}>Continue</a>.
        </p>
      </body>
    </html>
  ) : (
    <CourseLayout title={module.title} description={module.blurb} current={module.slug}>
      <article>
        <p class="psych-kicker">{kicker}</p>
        <h1>{module.title}</h1>
        <Levels overview={module.levels.overview} detailed={module.levels.detailed} points={module.levels.points} figures={module.figures} />
        {module.datasetNote && (
          <aside class="dataset-note">
            <span>{module.datasetNote}</span>
          </aside>
        )}
        {module.showFlow && <TestFlow />}
        {module.slug === "r-setup" && <ShotSubmit />}
        {module.starter && (
          <RPlayground
            slug={module.slug}
            starter={module.starter}
            setup={module.setup || ""}
            check={module.check || ""}
            checkHint={module.checkHint || ""}
            xp={module.xp}
            badge={module.badge}
          />
        )}
        <p class="self-check">
          <button
            type="button"
            id="mark-complete"
            data-slug={module.slug}
            data-xp={module.xp}
            data-badge={module.badge || ""}
          >
            Mark as completed
          </button>
          <span id="mark-status" role="status"></span>
        </p>
      </article>
    </CourseLayout>
  )
}

<script>
  import { loadProgress, saveProgress } from "../../lib/progress";

  function paint(button: HTMLButtonElement, done: boolean) {
    button.dataset.done = done ? "1" : "0";
    button.textContent = done ? "Mark as not completed" : "Mark as completed";
    button.classList.toggle("is-done", done);
    const node = document.querySelector<HTMLElement>(`#course-path [data-module="${button.dataset.slug}"]`);
    node?.classList.toggle("done", done);
  }

  async function boot() {
    const button = document.getElementById("mark-complete") as HTMLButtonElement | null;
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "1";
    const rows = await loadProgress();
    const current = rows.find((row) => row.slug === button.dataset.slug);
    paint(button, current?.status === "checked");
    button.addEventListener("click", async () => {
      const done = button.dataset.done !== "1";
      const saved = await saveProgress(
        {
          slug: button.dataset.slug || "",
          status: done ? "checked" : "started",
          xp: done ? Number(button.dataset.xp || 0) : 0,
          badges: done && button.dataset.badge ? [button.dataset.badge] : [],
        },
        true
      );
      paint(button, done);
      const status = document.getElementById("mark-status");
      if (status) {
        const where = saved.remote ? "Saved to your account." : "Saved on this device.";
        status.textContent = done ? `Marked completed. ${where}` : `Marked not completed. ${where}`;
      }
    });
  }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>
