---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CourseNav from "../../components/psychstats/CourseNav.astro";
import { MODULES } from "../../data/psychstats/modules";
import { supabaseConfigured } from "../../lib/supabase";

const configured = supabaseConfigured();
const moduleJson = JSON.stringify(
  MODULES.map((m) => ({ slug: m.slug, title: m.title, href: m.href }))
);
---

<BaseLayout title="Student portal" description="Sign in, join a class, and see which psych stats modules are assigned." sideBarActiveItemID="psychstats">
  <div class="max-w-3xl mx-auto">
    <CourseNav current="portal" />
    <h1 class="text-4xl font-bold mb-4">Student portal</h1>
    {
      configured ? (
        <div id="portal-app" class="space-y-6" data-modules={moduleJson}>
          <form id="sign-in" class="space-y-3">
            <p>Enter the email you use for class. We will send a sign-in link. There is no password.</p>
            <input class="input input-bordered w-full" type="email" name="email" required placeholder="you@school.edu" />
            <button class="btn btn-primary" type="submit">Email me a link</button>
            <p id="sign-in-status" class="text-sm" role="status"></p>
          </form>
          <div id="signed-in" class="hidden space-y-6">
            <p id="who"></p>
            <button type="button" id="sign-out" class="btn btn-ghost btn-sm">Sign out</button>
            <form id="join" class="space-y-3">
              <h2 class="text-2xl font-semibold">Join a class</h2>
              <input class="input input-bordered w-full max-w-xs uppercase" name="code" required placeholder="Class code" />
              <button class="btn btn-primary" type="submit">Join</button>
              <p id="join-status" class="text-sm" role="status"></p>
            </form>
            <section>
              <h2 class="text-2xl font-semibold mb-3">Assigned modules</h2>
              <ul id="assigned" class="space-y-2"></ul>
            </section>
          </div>
        </div>
      ) : (
        <div class="alert">
          <span>
            Sign-in is not configured on this build. Lessons and on-device progress still work. Add
            PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY, then run supabase/schema.sql in the Supabase project.
          </span>
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  import { getSupabase } from "../../lib/supabase";

  async function boot() {
  const root = document.getElementById("portal-app");
  const sb = getSupabase();
  if (root && sb && !root.dataset.ready) {
    root.dataset.ready = "1";
    const modules = JSON.parse(root.dataset.modules || "[]") as { slug: string; title: string; href: string }[];
    const bySlug = new Map(modules.map((m) => [m.slug, m]));
    const signIn = document.getElementById("sign-in") as HTMLFormElement;
    const signedIn = document.getElementById("signed-in")!;
    const who = document.getElementById("who")!;
    const signInStatus = document.getElementById("sign-in-status")!;
    const joinStatus = document.getElementById("join-status")!;
    const assigned = document.getElementById("assigned")!;

    async function refresh(userId: string, email: string) {
      signIn.classList.add("hidden");
      signedIn.classList.remove("hidden");
      who.textContent = `Signed in as ${email}.`;
      const { data: rows, error } = await sb
        .from("assignments")
        .select("module_slug, class_id");
      assigned.innerHTML = "";
      if (error) {
        joinStatus.textContent = error.message;
        return;
      }
      const slugs = Array.from(new Set((rows ?? []).map((row) => row.module_slug as string)));
      if (slugs.length === 0) {
        assigned.innerHTML = "<li>Nothing is assigned yet. Join a class with the code from your instructor.</li>";
        return;
      }
      const { data: progress } = await sb.from("progress").select("module_slug,status,xp").eq("user_id", userId);
      const done = new Map((progress ?? []).map((row) => [row.module_slug as string, row]));
      for (const slug of slugs) {
        const meta = bySlug.get(slug);
        const state = done.get(slug);
        const li = document.createElement("li");
        const label = state?.status === "checked" ? `Checked, ${state.xp} points` : state ? "Started" : "Not started";
        li.innerHTML = `<a class="link" href="${meta?.href ?? "/psychstats/"}">${meta?.title ?? slug}</a> <span class="opacity-70">(${label})</span>`;
        assigned.appendChild(li);
      }
    }

    signIn.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = new FormData(signIn).get("email");
      signInStatus.textContent = "Sending the link…";
      const { error } = await sb.auth.signInWithOtp({
        email: String(email),
        options: { emailRedirectTo: `${location.origin}/psychstats/portal/` },
      });
      signInStatus.textContent = error ? error.message : "Check your email for the sign-in link.";
    });

    document.getElementById("sign-out")!.addEventListener("click", async () => {
      await sb.auth.signOut();
      location.reload();
    });

    document.getElementById("join")!.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const code = new FormData(form).get("code");
      const { error } = await sb.rpc("join_class", { code: String(code) });
      joinStatus.textContent = error ? error.message : "You joined the class.";
      const { data } = await sb.auth.getUser();
      if (data.user?.email) await refresh(data.user.id, data.user.email);
    });

    const { data } = await sb.auth.getUser();
    if (data.user?.email) await refresh(data.user.id, data.user.email);
  }
  }
  void boot();
  document.addEventListener("astro:page-load", () => {
    void boot();
  });
</script>
