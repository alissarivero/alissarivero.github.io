---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-2">
    <div class="text-xl py-1"></div>

    <div class="flex justify-center py-0">
      <img
        src="/name_draw.webp"
        alt="Name illustration"
          class="h-76 md:h-80 object-contain w-full max-w-none lg:max-w-[1800px]"
      />
    </div>    

    <div class="flex justify-center py-2">
      <p class="text-lg text-center max-w-3xl">
        I am a developmental psychologist interested in understanding how we can best structure childhood to help humans reach our full potential.
        My research investigates how relatively new influences on children's everyday lives (such as extrinsic rewards and highly involved caregivers) can both amplify and undermine children's cognitive strengths.
        I currently work with Dorsa Amir and Mike Tomasello at Duke, where I am supported by the NSF GRFP. Feel free to reach out! alissa.rivero@duke.edu
      </p>
    </div>

    <div class="mt-8 flex flex-col items-center relative">
      <a
        href="/research-interests/"
        class="btn btn-outline mb-2 z-10 relative top-4"
      >
        Learn more about my research
      </a>

      <div class="flex justify-center w-full relative -mt-12">
        <img
          src="/grass_draw.webp"
          alt="Grass illustration"
          class="h-76 md:h-80 object-contain w-[95%] md:w-[100%] max-w-[1000px] z-0"
        />
      </div>

          <div class="flex justify-center py-2">


    </div>
  </div>
</BaseLayout>
