---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Research Questions" sideBarActiveItemID="research-questions">
  <div class="max-w-5xl mx-auto">
    <div class="mb-5 text-center">
      <div class="text-5xl w-full font-bold">Research Questions</div>
    </div>

    <div class="mx-auto mt-4 mb-8 h-[2px] w-full bg-white opacity-80"></div>

    <section class="px-4 pb-12 md:px-10 xl:px-16">
      <div class="time-line-container grid gap-4 max-w-4xl mx-auto">
        <TimeLineElement
          title="When can children coordinate decisions in groups?"
          titleHref="/papers/Rivero-et-al-2026-dyad-triad.pdf"
          answer={`By age 3. Communication predicts their success. (Rivero, Vasil, & Tomasello, 2026 | Child Development)`}
        />
        <TimeLineElement
          title="Would young children exploit if they cared more about the goal?"
          answer="Currently investigating this question with Ben Pitt, Carolina Deus, and Dorsa Amir! We think so."
        />
        <TimeLineElement
          title="Do directive adults lead children to try less after instructions go away?"
          answer={`Currently investigating this question with Julia Leonard, Mike Tomasello, and Dorsa Amir! We think so (compared to questioning adults or those who encourage independence).`}
        />
        <TimeLineElement
          title="How do children learn differently from adult versus peer instruction?"
          answer={`Currently investigating this question with Mike Tomasello! We think that instruction from peers may constrain children's exploration less than instruction from adults.`}
        />
        <TimeLineElement
          title="Why do children 'reset' more than adults? What are the differences between children's and adults' creativity?"
          answer={`Currently investigating this question with Dorsa Amir! We think resetting might facilitate exploration.`}
        />
      </div>
    </section>

    <div class="mt-8 flex flex-col items-center relative">
      <div class="flex justify-center w-full relative -mt-12">
        <img
          src="/grass_draw.webp"
          alt="Grass illustration"
          class="h-76 md:h-80 object-contain w-[95%] md:w-[100%] max-w-[1000px] z-0"
        />
      </div>
    </div>
  </div>
</BaseLayout>
